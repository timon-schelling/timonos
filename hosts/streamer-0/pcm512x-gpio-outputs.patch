+static int pcm512x_set_gpio_outputs(struct device *dev, struct regmap *regmap)
+{
+	static const char * const props[] = {
+		"ti,gpio-output-low", "ti,gpio-output-high",
+	};
+	unsigned int enable = 0, level = 0;
+	u32 gpios[6];
+	int i, n, ret;
+
+	for (i = 0; i < ARRAY_SIZE(props); i++) {
+		n = device_property_count_u32(dev, props[i]);
+		if (n <= 0)
+			continue;
+		if (n > ARRAY_SIZE(gpios)) {
+			dev_err(dev, "Too many entries in %s\n", props[i]);
+			return -EINVAL;
+		}
+		ret = device_property_read_u32_array(dev, props[i], gpios, n);
+		if (ret)
+			return ret;
+		while (n--) {
+			if (gpios[n] < 1 || gpios[n] > 6) {
+				dev_err(dev, "Invalid GPIO %u in %s\n",
+					gpios[n], props[i]);
+				return -EINVAL;
+			}
+			ret = regmap_update_bits(regmap,
+					PCM512x_GPIO_OUTPUT_1 + gpios[n] - 1,
+					PCM512x_GxSL, PCM512x_GxSL_REG);
+			if (ret)
+				return ret;
+			enable |= BIT(gpios[n] - 1);
+			if (i)
+				level |= BIT(gpios[n] - 1);
+		}
+	}
+
+	if (!enable)
+		return 0;
+
+	ret = regmap_update_bits(regmap, PCM512x_GPIO_CONTROL_1, enable, level);
+	if (ret)
+		return ret;
+	return regmap_update_bits(regmap, PCM512x_GPIO_EN, enable, enable);
+}
