+void GreeterSurface::takeAuthenticationFrom(GreeterSurface& other) {
+  m_authenticating = std::exchange(other.m_authenticating, false);
+  m_authSessionStarted = std::exchange(other.m_authSessionStarted, false);
+  m_cancelAuthRequested = std::exchange(other.m_cancelAuthRequested, false);
+  m_secretPromptWaiting = std::exchange(other.m_secretPromptWaiting, false);
+  m_hasPendingResponse = std::exchange(other.m_hasPendingResponse, false);
+  m_pendingResponse = std::exchange(other.m_pendingResponse, {});
+  m_pendingReplies = std::exchange(other.m_pendingReplies, {});
+  m_password = other.m_password;
+  if (m_passwordField != nullptr) {
+    m_passwordField->setValue(m_password);
+  }
+  other.clearPasswordInput();
+}
