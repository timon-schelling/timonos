 namespace nix::fetchers {

+static std::optional<Path> findJjRoot(Path dir)
+{
+    while (true) {
+        if (pathExists(dir + "/.git"))
+            return std::nullopt;
+        if (pathExists(dir + "/.jj"))
+            return dir;
+        if (dir == "/")
+            return std::nullopt;
+        dir = dirOf(dir);
+    }
+}
+
+static kj::Promise<Result<std::pair<int, std::string>>>
+runJjFileList(const Path & jjRoot, bool snapshot)
+{
+    Strings args = {
+        "--no-pager", "--color=never", "-R", jjRoot, "file", "list", "-T", "path ++ \"\\0\""
+    };
+    if (!snapshot)
+        args.push_front("--ignore-working-copy");
+    return runProgram(RunOptions{
+        .program = "jj",
+        .args = args,
+    });
+}
+
+static kj::Promise<Result<std::set<std::string>>>
+jjTrackedFiles(const Path & jjRoot, const Path & root)
+try {
+    bool snapshot = lstat(jjRoot + "/.jj").st_uid == geteuid();
+    auto result = TRY_AWAIT(runJjFileList(jjRoot, snapshot));
+
+    if (snapshot && !statusOk(result.first)) {
+        printTaggedWarning(
+            "jj could not snapshot the working copy of '%s', using its last snapshot", jjRoot
+        );
+        result = TRY_AWAIT(runJjFileList(jjRoot, false));
+    }
+
+    if (!statusOk(result.first))
+        throw Error(
+            "could not list the files jj tracks in '%s': jj %s",
+            jjRoot,
+            statusToString(result.first)
+        );
+
+    auto & out = result.second;
+    auto prefix = root == jjRoot
+        ? std::string()
+        : root.substr(jjRoot.size() + (jjRoot == "/" ? 0 : 1)) + "/";
+    std::set<std::string> files;
+    for (auto & line : tokenizeString<Strings>(out, std::string_view("\0", 1)))
+        if (line.starts_with(prefix))
+            files.insert(line.substr(prefix.size()));
+    co_return files;
+} catch (...) {
+    co_return result::current_exception();
+}
